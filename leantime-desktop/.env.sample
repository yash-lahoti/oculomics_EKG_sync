# Minimal Leantime config for a local single-user install on macOS.
# Copy over ~/Leantime/config/.env (or start from Leantime's own config/sample.env —
# every key here exists there; anything not listed is optional and off by default).
# Format matters: keep the quotes.

## App
LEAN_APP_URL = "http://localhost:8080"
LEAN_SITENAME = "Residency Planner"
LEAN_LANGUAGE = "en-US"
LEAN_DEFAULT_TIMEZONE = "America/New_York"
LEAN_DEBUG = "0"

## Session security — REQUIRED. Generate with:  openssl rand -hex 32
LEAN_SESSION_PASSWORD = "REPLACE_ME_openssl_rand_hex_32"
LEAN_SESSION_EXPIRATION = "28800"

## Database (matches Step 2 of LOCAL_SETUP.md)
LEAN_DB_DEFAULT_CONNECTION = "mysql"
LEAN_DB_HOST = "localhost"
LEAN_DB_PORT = "3306"
LEAN_DB_USER = "leantime"
LEAN_DB_PASSWORD = "REPLACE_ME_db_password_from_step_2"
LEAN_DB_DATABASE = "leantime"

## Email from-address (only used if you later configure SMTP; harmless placeholder)
LEAN_EMAIL_RETURN = "leantime@localhost.local"
